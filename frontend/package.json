{
  "name": "nexus-terminal-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Frontend for Nexus Terminal desktop SSH client",
  "scripts": {
    "install:assets": "node scripts/copy-assets.js",
    "bundle:novnc": "node scripts/bundle-novnc.js",
    "build": "node scripts/build.js",
    "dev": "node scripts/build.js --watch",
    "test": "node scripts/test-regressions.js",
    "postinstall": "npm run install:assets && npm run bundle:novnc"
  },
  "dependencies": {
    "@novnc/novnc": "^1.5.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
