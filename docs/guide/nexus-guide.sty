% nexus-guide.sty: the look of the Nexus Terminal user guide. Build with lualatex (see Makefile).
% The layout is the uncomplex. user-guide format, shared with the Apex and Salvage guides (spec:
% salvage/docs/BRANDING.md): a white page, Inter in near-black ink, one blue accent, outlined boxes, and a
% chapter rhythm of TL;DR, time, then sections. Every chapter stands on its own, so read in any order.
% The macro names (\keys, \ui, tldr, headsup, \guidepart, ...) are the ones the chapters already use.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{nexus-guide}

\RequirePackage[a4paper,top=22mm,bottom=26mm,left=24mm,right=24mm,
  headheight=14pt,headsep=8mm,footskip=14mm]{geometry}
% Latin Modern OpenType isn't always installed, and the kernel selects it once before the guide's own
% fonts take over. Point that one use at Inter so the build doesn't need it.
\DeclareFontShape{TU}{lmr}{m}{n}{<->"[../../rust/app/assets/fonts/Inter-Regular.ttf]:mode=node;"}{}
\RequirePackage{fontspec}
\RequirePackage[dvipsnames]{xcolor}
\RequirePackage{graphicx}
\RequirePackage[most]{tcolorbox}
\RequirePackage{tikz}
\usetikzlibrary{calc,positioning}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}
\RequirePackage{booktabs,tabularx,array,colortbl}
\RequirePackage{multicol}
\RequirePackage{etoolbox}
\RequirePackage{needspace}
\RequirePackage{microtype}
\RequirePackage[hidelinks]{hyperref}
\RequirePackage{bookmark}

% ---------------------------------------------------------------- colours (salvage/docs/BRANDING.md)
\definecolor{uink}{HTML}{171717}      % text, rules under titles, box frames, TL;DR tab
\definecolor{ugrey}{HTML}{525252}     % secondary text: subtitles, contents sections, header title
\definecolor{umuted}{HTML}{737373}    % quiet text: section numbers, page numbers, time, captions
\definecolor{urule}{HTML}{D4D4D4}     % table rules, key outlines
\definecolor{uhair}{HTML}{E5E5E5}     % header rule, light box outlines
\definecolor{upanel}{HTML}{FAFAFA}    % code panels, keys, the summary box
\definecolor{ublue}{HTML}{2F6DB5}     % the one accent: wordmark dot, CHAPTER label, contents numbers
\definecolor{ugreen}{HTML}{3F6B4A}    % done / good
\definecolor{uambertext}{HTML}{8A5A00}% Watch out: icon and label
\definecolor{uamberline}{HTML}{CAB58C}% Watch out: outline
\definecolor{uamberback}{HTML}{FDF8EC}% Watch out: fill
\definecolor{ured}{HTML}{B42318}      % never / cannot

% The names the chapters use. Neutral ones map onto the tokens above; the rest are the app's own
% colours, kept only for \proto tags that reproduce what the app shows.
\colorlet{ink}{uink}
\colorlet{ink2}{uink}
\colorlet{body}{uink}
\colorlet{muted}{umuted}
\colorlet{rule}{urule}
\colorlet{paper}{upanel}
\colorlet{accent}{ublue}
\colorlet{partcol}{uink}
\colorlet{green}{ugreen}
\colorlet{rose}{ured}
\definecolor{teal}{HTML}{0F766E}
\definecolor{violet}{HTML}{6D28D9}
\definecolor{amber}{HTML}{B45309}
\definecolor{pink}{HTML}{BE185D}
\definecolor{slate}{HTML}{475569}

% ---------------------------------------------------------------- fonts
% Inter and Fira Mono come from TeX Live (texlive-fonts-extra); Phosphor, the app's icon set, from fonts/.
\defaultfontfeatures{Ligatures=TeX}
\setmainfont{Inter-Regular.otf}[
  BoldFont=Inter-Bold.otf, ItalicFont=Inter-Italic.otf,
  BoldItalicFont=Inter-BoldItalic.otf]
\setsansfont{Inter-Regular.otf}[BoldFont=Inter-Bold.otf]
\setmonofont{FiraMono-Regular.otf}[BoldFont=FiraMono-Bold.otf, Scale=0.86]
\newfontfamily\semibold{Inter-SemiBold.otf}[ItalicFont=Inter-SemiBoldItalic.otf]
\newfontfamily\lightfont{Inter-Light.otf}[ItalicFont=Inter-LightItalic.otf]
\newfontfamily\labelfont{Inter-SemiBold.otf}[LetterSpace=12]
\let\heavy\semibold
\newfontfamily\phfont{Phosphor.ttf}[Path=fonts/]
\newfontfamily\phfill{Phosphor-Fill.ttf}[Path=fonts/]

\AtBeginDocument{\color{uink}\arrayrulecolor{urule}}
\linespread{1.1}
\setlength\parindent{0pt}
\setlength\parskip{6pt plus 1.5pt minus 0.5pt}
\setlength\emergencystretch{3em}
\raggedbottom

% The product's wordmark: lower case, bold, a blue full stop. The publisher's: the same, in ink.
\newcommand\wordmark{{\bfseries nexus terminal\textcolor{ublue}{.}}}
\newcommand\uncomplex{{\bfseries uncomplex.}}

