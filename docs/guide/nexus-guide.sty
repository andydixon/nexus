% Thumb tabs on the page edge, one slot per part, so you can flick to a part in print.
\newif\ifthumbs
\AddToShipoutPictureBG{%
  \ifthumbs\ifnum\value{guidepart}>0
  \AtPageLowerLeft{\begin{tikzpicture}[overlay]\pgnode
    \pgfmathsetmacro\slot{28 + (\value{guidepart}-1)*30}
    \ifodd\value{page}
      \fill[partcol, rounded corners=4pt] ([xshift=-7mm, yshift=-\slot mm]pg.north east) rectangle ++(9mm,-26mm);
      \node[rotate=-90, text=white, font=\heavy\tiny] at ([xshift=-3.6mm, yshift=-\slot mm - 13mm]pg.north east) {\MakeUppercase{\partshort}};
    \else
      \fill[partcol, rounded corners=4pt] ([xshift=7mm, yshift=-\slot mm]pg.north west) rectangle ++(-9mm,-26mm);
      \node[rotate=90, text=white, font=\heavy\tiny] at ([xshift=3.6mm, yshift=-\slot mm - 13mm]pg.north west) {\MakeUppercase{\partshort}};
    \fi
  \end{tikzpicture}}\fi\fi}

% \guidepart{colour}{short name}{Title}{tagline}{list of chapters}
\newcommand\guidepart[5]{%
  \clearpage
  \stepcounter{guidepart}\colorlet{partcol}{#1}\renewcommand\partshort{#2}
  \phantomsection\addcontentsline{toc}{part}{\protect\textcolor{#1}{\arabic{guidepart}}\quad #3}
  \thispagestyle{empty}\thumbsfalse
  \pagecanvas{
    \fill[ink] (pg.south west) rectangle (pg.north east);
    \fill[#1, opacity=0.9] (pg.north west) rectangle ([yshift=-95mm]pg.north east);
    \fill[#1!70!black, opacity=0.35] ([yshift=-95mm]pg.north west) -- ++(0,-18mm) -- ([yshift=-95mm]pg.north east) -- cycle;
    \node[anchor=north west, text=white, font=\heavy\fontsize{150}{150}\selectfont, opacity=0.25]
      at ([xshift=14mm, yshift=-4mm]pg.north west) {\arabic{guidepart}};
    \node[anchor=south west, text=white, font=\heavy\small] at ([xshift=24mm, yshift=-72mm]pg.north west) {PART \arabic{guidepart}};
    \node[anchor=north west, text=white, font=\heavy\fontsize{38}{42}\selectfont, text width=160mm]
      at ([xshift=24mm, yshift=-73mm]pg.north west) {#3};
    \node[anchor=north west, text=white!80!#1, font=\large, text width=150mm]
      at ([xshift=24mm, yshift=-125mm]pg.north west) {#4};
    \node[anchor=north west, text=white, font=\normalsize, text width=150mm]
      at ([xshift=24mm, yshift=-145mm]pg.north west) {#5};
  }\null\clearpage\thumbstrue}
