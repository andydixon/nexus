% ---------------------------------------------------------------- inline bits
% \kbd{Ctrl}: a keycap. \keys{Ctrl+Shift+K}: keycaps joined with thin pluses.
\newtcbox{\kbd}{on line, boxrule=0.4pt, arc=1.6pt, colback=upanel, colframe=urule,
  boxsep=0pt, left=2.6pt, right=2.6pt, top=1.6pt, bottom=1.2pt, fontupper=\ttfamily\footnotesize\color{uink}}
% \mod is "Ctrl, or Command on a Mac": every shortcut in the guide is written \keys{\mod+K}.
\renewcommand\mod{\kbd{Ctrl\,/\,\ph{E1C4}}}
\def\keystop{\relax}\def\modtok{\mod}
\DeclareRobustCommand\keys[1]{\keysplit#1+\relax+}
\def\keysplit#1+{\def\kk{#1}\ifx\kk\keystop\else\keycap{#1}\expandafter\keysplitnext\fi}
\def\keysplitnext#1+{\def\kk{#1}\ifx\kk\keystop\else{\kern0.15em\scriptsize\color{umuted}+\kern0.15em}\keycap{#1}\expandafter\keysplitnext\fi}
\newcommand\keycap[1]{\def\kc{#1}\ifx\kc\modtok\mod\else\kbd{#1}\fi}

\newcommand\ui[1]{\leavevmode{\semibold\color{uink}#1}}     % on-screen labels
\newcommand\code[1]{\leavevmode{\ttfamily\color{uink}#1}}    % file paths and commands
\newcommand\menu[1]{\ui{#1}}                                % File > Thing
\newcommand\then{\ {>}\ }
% A tag the application shows (protocol badges, READ ONLY). #1 is the app's colour for it.
\newcommand\proto[2][uink]{\tikz[baseline=(p.base)]\node[draw=#1!45,fill=#1!6,text=#1!85!black,rounded corners=2pt,
  line width=0.4pt,inner xsep=3pt,inner ysep=1.4pt,font=\scriptsize\labelfont](p){#2};}

% ---------------------------------------------------------------- lists
\setlist{itemsep=3pt,topsep=3pt,parsep=0pt}
\setlist[itemize,1]{label={\color{umuted}\textbullet},leftmargin=1.5em}
\setlist[itemize,2]{label={\color{umuted}\textendash},leftmargin=1.3em}
\setlist[enumerate,1]{label={\semibold\arabic*.},leftmargin=1.6em}
\setlist[description]{font=\bfseries,leftmargin=1.6em,itemsep=4pt}
\newlist{checklist}{itemize}{1}
\setlist[checklist]{label={\color{umuted}\iBox},leftmargin=1.7em,itemsep=3pt}

% ---------------------------------------------------------------- boxes
\tcbset{ubox/.style={enhanced,breakable,arc=3pt,left=7pt,right=7pt,top=5pt,bottom=5pt,
  before skip=10pt,after skip=10pt,parbox=false,before upper={\setlength{\parskip}{0.5em}}}}
% TL;DR: the chapter in a few lines. An ink outline with a black tab on its top edge.
\newtcolorbox{tldr}{ubox,colback=white,colframe=uink,boxrule=0.8pt,top=6pt,before skip=16pt,
  attach boxed title to top left={xshift=7pt,yshift*=-\tcboxedtitleheight/2},
  boxed title style={colback=uink,colframe=uink,boxrule=0pt,arc=2pt,left=4pt,right=4pt,top=1pt,bottom=1pt},
  title={\iBolt\enspace TL;DR},fonttitle=\footnotesize\semibold,coltitle=white,
  after={\uflushmeta}}
% Quick win: a small thing to do now. Optional argument: its title.
\newtcolorbox{quickwin}[1][Quick win]{ubox,colback=white,colframe=uink,boxrule=0.6pt,
  colbacktitle=white,coltitle=uink,titlerule=0.4pt,titlerule style=uink,toptitle=2pt,bottomtitle=2pt,
  title={\iPlay\enspace #1},fonttitle=\footnotesize\semibold}
% Watch out: what catches people out. Amber. Optional argument replaces the label.
\newtcolorbox{headsup}[1][Watch out.]{ubox,colback=uamberback,colframe=uamberline,boxrule=0.5pt,
  before upper={\setlength{\parskip}{0.5em}{\color{uambertext}\iWarn\enspace\textbf{#1}}\enspace}}
% Careful: anything that can lose data or weaken security. A dashed ink outline.
\newtcolorbox{danger}[1][Careful.]{ubox,colback=white,frame hidden,
  borderline={0.6pt}{0pt}{uink,dash pattern=on 2.5pt off 1.5pt},
  before upper={\setlength{\parskip}{0.5em}{\iShield\enspace\textbf{#1}}\enspace}}
% Pro tip: a trick or the reasoning behind a behaviour. The quiet panel.
\newtcolorbox{protip}[1][Pro tip.]{ubox,colback=upanel,colframe=uhair,boxrule=0.5pt,
  before upper={\setlength{\parskip}{0.5em}{\color{ugrey}\iBulb}\enspace\textbf{#1}\enspace}}
% Side quest: optional. A hairline outline and a quiet "skip it" note.
\newtcolorbox{sidequest}[1][Side quest]{ubox,colback=white,colframe=uhair,boxrule=0.5pt,
  before upper={\setlength{\parskip}{0.5em}{\color{ugrey}\iForward}\enspace\textbf{#1}%
    {\small\color{umuted}\enspace·\enspace optional; skip it if you are in a hurry}\par}}

% How long a chapter takes and what you get from it. Printed under the TL;DR, or before the first
% section when a chapter has none.
\def\ucmeta{}
\newcommand\chapmeta[2]{\gdef\ucmeta{#1\enspace·\enspace #2}}
\newcommand\uflushmeta{\ifx\ucmeta\empty\else
  \par\vspace{-4pt}{\small\color{umuted}\iClock\enspace\itshape\ucmeta}\par\vspace{4pt}\gdef\ucmeta{}\fi}
\AddToHook{cmd/section/before}{\uflushmeta}
% How you know you have finished: the last line of every chapter.
\newcommand\donewhen[1]{\par\vspace{8pt}{\color{ugreen}\iCheck}\enspace\textbf{Done when} #1\par}

% ---------------------------------------------------------------- screenshots
% \shot[width]{file}{caption}: centred, no frame, caption after an image icon.
\newcommand\ucaption[1]{{\footnotesize\color{umuted}\iImage\enspace #1}}
\newcommand\shot[3][\linewidth]{%
  \par\needspace{0.3\textheight}\begin{center}
  \includegraphics[width=#1]{img/#2}\par\vspace{3pt}\ucaption{#3}\end{center}\vspace{-4pt}}
\newcommand\shotpair[4]{%
  \par\needspace{0.22\textheight}\begin{center}
  \begin{minipage}[t]{0.485\linewidth}\centering\includegraphics[width=\linewidth]{img/#1}\par\vspace{3pt}\ucaption{#2}\end{minipage}\hfill
  \begin{minipage}[t]{0.485\linewidth}\centering\includegraphics[width=\linewidth]{img/#3}\par\vspace{3pt}\ucaption{#4}\end{minipage}
  \end{center}}
% A crop of a screenshot: \crop{file}{left}{bottom}{right}{top}{width}{caption}, trims in px of the 2720x1720 image.
\newcommand\crop[7]{%
  \par\needspace{0.2\textheight}\begin{center}
  \includegraphics[width=#6, trim=#2 #3 #4 #5, clip]{img/#1}\par\vspace{3pt}\ucaption{#7}\end{center}\vspace{-4pt}}
% Annotated screenshot: \begin{annotated}{file} \callout{1}{x}{y} ... \end{annotated}, x/y in 0-1 from top left.
\newenvironment{annotated}[1]{%
  \par\begin{center}\begin{tikzpicture}
  \node[anchor=north west, inner sep=0pt] (img) {\includegraphics[width=\linewidth]{img/#1}};
  \begin{scope}[x={(img.north east)}, y={($(img.north west)-(img.south west)$)}, shift={(img.north west)}]}
  {\end{scope}\end{tikzpicture}\end{center}}
\newcommand\callout[3]{%
  \node[circle, fill=uink, text=white, font=\semibold\footnotesize, inner sep=0pt, minimum size=15pt,
    draw=white, line width=1.2pt] at (#2,-#3) {#1};}
\newcommand\num[1]{\tikz[baseline=(n.base)]\node[circle, fill=uink, text=white, font=\semibold\scriptsize,
  inner sep=0pt, minimum size=13pt] (n) {#1};}

% "At a glance" fact card for each connection type. #1 (a colour) is ignored: the format has one accent.
\newenvironment{glance}[2]{%
  \begin{tcolorbox}[ubox, colback=upanel, colframe=uhair, boxrule=0.5pt, left=9pt, right=9pt, top=7pt, bottom=7pt,
    fontupper=\small, overlay={\node[anchor=north east, font=\labelfont\tiny, text=umuted, inner sep=8pt]
      at (frame.north east) {AT A GLANCE};}]
  {\bfseries\large\color{uink}#2}\par\vspace{4pt}
  \renewcommand\arraystretch{1.3}\begin{tabular}{@{}>{\leavevmode\color{ugrey}}p{0.24\linewidth}>{\leavevmode}p{0.72\linewidth}@{}}}
  {\end{tabular}\end{tcolorbox}}

% Symptom and fix cards for troubleshooting.
\newcommand\fix[2]{%
  \begin{tcolorbox}[ubox, colback=white, colframe=urule, boxrule=0.5pt, fontupper=\small, left=9pt, right=9pt,
    top=6pt, bottom=6pt, before skip=6pt, after skip=8pt]
  {\semibold\normalsize\color{uink}{\color{umuted}\iBug}\enspace #1}\par\vspace{2pt}
  #2\end{tcolorbox}}

% A line on its own to break up long stretches.
\newcommand\breather[1]{\par\vspace{6pt}{\centering\bfseries\large\color{uink}#1\par}\vspace{6pt}}

% ---------------------------------------------------------------- tables
\setlength\heavyrulewidth{0.5pt}
\setlength\lightrulewidth{0.4pt}
\renewcommand\arraystretch{1.3}

% ---------------------------------------------------------------- header and footer
\pagestyle{fancy}
\fancyhf{}
\renewcommand\headrule{{\color{uhair}\hrule height 0.4pt width\headwidth}}
\fancyhead[L]{\small\wordmark\enspace{\color{ugrey}The User Guide}}
\fancyhead[R]{\small\color{ugrey}\nouppercase{\leftmark}}
\fancyfoot[C]{\small\color{umuted}\thepage}
\fancypagestyle{plain}{\fancyhf{}\renewcommand\headrule{}\fancyfoot[C]{\small\color{umuted}\thepage}}
\renewcommand\chaptermark[1]{\markboth{#1}{}}
\renewcommand\sectionmark[1]{}
\renewcommand\contentsname{Contents}

% ---------------------------------------------------------------- headings
% Chapter: a spaced blue label, a large bold title, a rule in ink across the text width.
\newcommand\uchapterrule{\par\vspace{7pt}{\color{uink}\hrule height 0.8pt}\vspace{4pt}}
\titleformat{\chapter}[display]
  {\normalfont}
  {\labelfont\small\color{ublue}CHAPTER\ \thechapter}
  {10pt}
  {\bfseries\fontsize{24.5}{29}\selectfont\color{uink}}
  [\uchapterrule]
\titleformat{name=\chapter,numberless}[display]
  {\normalfont}{}{0pt}
  {\vspace*{18pt}\bfseries\fontsize{24.5}{29}\selectfont\color{uink}}
  [\uchapterrule]
\titlespacing*{\chapter}{0pt}{2pt}{8pt}
\pretocmd{\chapter}{\gdef\ucmeta{}}{}{}

\titleformat{\section}[hang]{\bfseries\fontsize{14.4}{18}\selectfont\color{uink}}
  {{\semibold\color{umuted}\thesection}}{0.75em}{}
\titlespacing*{\section}{0pt}{18pt plus 4pt minus 2pt}{6pt}
\titleformat{\subsection}[block]{\bfseries\fontsize{11.5}{14}\selectfont\color{uink}}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{12pt plus 3pt}{3pt}
\renewcommand\thesection{\arabic{chapter}.\arabic{section}}
\setcounter{secnumdepth}{1}
\setcounter{tocdepth}{1}

% ---------------------------------------------------------------- parts
% \guidepart{colour}{short name}{Title}{tagline}{list of chapters}. A white opener in the chapter style;
% colour and short name are kept for the chapters' sake but unused.
\newcounter{guidepart}
\newcommand\guidepart[5]{%
  \clearpage\stepcounter{guidepart}\thispagestyle{empty}%
  \phantomsection\addcontentsline{toc}{part}{#3}%
  \vspace*{40mm}
  {\labelfont\small\color{ublue}PART\ \arabic{guidepart}\par}\vspace{10pt}
  {\bfseries\fontsize{24.5}{29}\selectfont\color{uink}#3\par}
  \uchapterrule\vspace{4mm}
  {\lightfont\fontsize{14.4}{17}\selectfont\color{ugrey}#4\par}
  \vspace{12mm}
  #5
  \clearpage}
\newcommand\partitem[2]{{\color{umuted}#1}\enspace #2\par\vspace{5pt}}

% ---------------------------------------------------------------- contents
\titlecontents{part}[0mm]{\addvspace{16pt}\labelfont\footnotesize\color{ugrey}}
  {}{}{}[\addvspace{2pt}]
\titlecontents{chapter}[8mm]{\addvspace{8pt}\bfseries\color{uink}}
  {\llap{\makebox[8mm][l]{\color{ublue}\thecontentslabel}}}{}
  {\hfill\contentspage}
\titlecontents{section}[8mm]{\addvspace{2.5pt}\small\color{ugrey}}
  {}{}
  {{\color{urule}\titlerule*[0.6pc]{.}}\contentspage}

% ---------------------------------------------------------------- cover and back page
\newcommand\makecover{%
  \thispagestyle{empty}%
  \begingroup
  \vspace*{-6mm}
  {\fontsize{12}{14}\selectfont\uncomplex\par}
  \vspace{20mm}
  {\fontsize{50}{54}\selectfont\wordmark\par}
  \vspace{9mm}
  {\color{uink}\hrule height 0.8pt}
  \vspace{8mm}
  {\bfseries\fontsize{24.5}{29}\selectfont The User Guide\par}
  \vspace{4mm}
  {\lightfont\fontsize{14.4}{17}\selectfont\color{ugrey}Every terminal you need. One window.\\
    SSH, Telnet, RAW, Serial, VNC, RDP, IRC and GitHub.\par}
  \vspace{9mm}
  \fcolorbox{uhair}{white}{\includegraphics[width=0.8\linewidth]{img/ssh-light.png}}\par
  \vspace{9mm}
  \begin{tcolorbox}[colback=upanel,colframe=uhair,boxrule=0.5pt,arc=3pt,left=8pt,right=8pt,top=6pt,bottom=6pt]
  Nexus Terminal puts every remote session in one native window: SSH with keys, jump hosts and 2FA, serial
  consoles, remote desktops, IRC and GitHub, with your passwords kept in the OS keychain or an encrypted vault.
  \textbf{Read in any order:} every chapter opens with a \textbf{TL;DR} and ends with a \textbf{Done when}
  check, so you always know when you can stop.
  \end{tcolorbox}
  \vfill
  {\color{uhair}\hrule height 0.4pt}
  \vspace{4mm}
  {\small\uncomplex\enspace Complicated things. Thoughtfully simplified.\hfill
    {\color{ugrey}Version \nexusversion\ \textperiodcentered\ \nexusdate}\par}
  \endgroup
  \clearpage}

% #1: the closing line, two short sentences.
\newcommand\makeback[1]{%
  \clearpage\thispagestyle{empty}%
  \vspace*{\fill}
  \begin{center}
    {\bfseries\large #1\par}
    \vspace{12mm}
    {\small\uncomplex\enspace Complicated things. Thoughtfully simplified.\par}
  \end{center}
  \vspace*{\fill}}

\endinput
