{
  "name": "leviathan",
  "displayName": "Leviathan",
  "description": "Leviathan binary analysis tools inside Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "andydixon",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "files": [
    "extension.js",
    "package.json",
    "media/**",
    "bin/**"
  ],
  "activationEvents": [
    "onView:leviathan.tools",
    "onCommand:leviathan.openSelected.hex",
    "onCommand:leviathan.openSelected.overview",
    "onCommand:leviathan.openSelected.hashes",
    "onCommand:leviathan.openSelected.entropy",
    "onCommand:leviathan.openSelected.strings",
    "onCommand:leviathan.openSelected.iocs",
    "onCommand:leviathan.openSelected.search",
    "onCommand:leviathan.openSelected.multi-search",
    "onCommand:leviathan.openSelected.parse",
    "onCommand:leviathan.openSelected.disasm",
    "onCommand:leviathan.openSelected.pdf",
    "onCommand:leviathan.openSelected.squashfs",
    "onCommand:leviathan.openSelected.spectrogram-encode",
    "onCommand:leviathan.openSelected.spectrogram-view",
    "onCommand:leviathan.openSelected.diff",
    "onCommand:leviathan.openSelected.carve",
    "onCommand:leviathan.openSelected.keys",
    "onCommand:leviathan.openSelected.timestamps",
    "onCommand:leviathan.openSelected.stego",
    "onCommand:leviathan.openSelected.metadata",
    "onCommand:leviathan.openSelected.binsnoop",
    "onCommand:leviathan.openSelected.rules",
    "onCommand:leviathan.openSelected.patch-plan",
    "onCommand:leviathan.openSelected.patch-apply",
    "onCommand:leviathan.openSelected.transform",
    "onCommand:leviathan.openSelected.case"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "leviathan.loadFile",
        "title": "Load Binary"
      },
      {
        "command": "leviathan.loadCompare",
        "title": "Load Compare Binary"
      },
      {
        "command": "leviathan.saveFile",
        "title": "Save Working Copy"
      },
      {
        "command": "leviathan.openTool",
        "title": "Open Leviathan Tool"
      },
      {
        "command": "leviathan.openSelected.hex",
        "title": "Hex Editor"
      },
      {
        "command": "leviathan.openSelected.overview",
        "title": "Overview"
      },
      {
        "command": "leviathan.openSelected.hashes",
        "title": "Hashes"
      },
      {
        "command": "leviathan.openSelected.entropy",
        "title": "Entropy"
      },
      {
        "command": "leviathan.openSelected.strings",
        "title": "Strings"
      },
      {
        "command": "leviathan.openSelected.iocs",
        "title": "IOCs"
      },
      {
        "command": "leviathan.openSelected.search",
        "title": "Search"
      },
      {
        "command": "leviathan.openSelected.multi-search",
        "title": "Multi-search"
      },
      {
        "command": "leviathan.openSelected.parse",
        "title": "Structures"
      },
      {
        "command": "leviathan.openSelected.disasm",
        "title": "Disasm"
      },
      {
        "command": "leviathan.openSelected.pdf",
        "title": "PDF"
      },
      {
        "command": "leviathan.openSelected.squashfs",
        "title": "SquashFS"
      },
      {
        "command": "leviathan.openSelected.spectrogram-encode",
        "title": "Spectrogram Encode"
      },
      {
        "command": "leviathan.openSelected.spectrogram-view",
        "title": "Spectrogram View"
      },
      {
        "command": "leviathan.openSelected.diff",
        "title": "Diff"
      },
      {
        "command": "leviathan.openSelected.carve",
        "title": "Carve"
      },
      {
        "command": "leviathan.openSelected.keys",
        "title": "Keys"
      },
      {
        "command": "leviathan.openSelected.timestamps",
        "title": "Timestamps"
      },
      {
        "command": "leviathan.openSelected.stego",
        "title": "Stego"
      },
      {
        "command": "leviathan.openSelected.metadata",
        "title": "Metadata"
      },
      {
        "command": "leviathan.openSelected.binsnoop",
        "title": "Binsnoop"
      },
      {
        "command": "leviathan.openSelected.rules",
        "title": "Rules"
      },
      {
        "command": "leviathan.openSelected.patch-plan",
        "title": "Patch Plan"
      },
      {
        "command": "leviathan.openSelected.patch-apply",
        "title": "Patch Apply"
      },
      {
        "command": "leviathan.openSelected.transform",
        "title": "Transforms"
      },
      {
        "command": "leviathan.openSelected.case",
        "title": "Case Export"
      }
    ],
    "submenus": [
      {
        "id": "leviathan.contextTools",
        "label": "Leviathan"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leviathan",
          "title": "Leviathan",
          "icon": "media/leviathan.svg"
        }
      ]
    },
    "views": {
      "leviathan": [
        {
          "id": "leviathan.tools",
          "name": "Tools",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "submenu": "leviathan.contextTools",
          "when": "resourceScheme == file && explorerResourceIsFolder == false",
          "group": "navigation"
        }
      ],
      "leviathan.contextTools": [
        {
          "command": "leviathan.openSelected.hex",
          "group": "01_editor"
        },
        {
          "command": "leviathan.openSelected.overview",
          "group": "02_triage@1"
        },
        {
          "command": "leviathan.openSelected.hashes",
          "group": "02_triage@2"
        },
        {
          "command": "leviathan.openSelected.entropy",
          "group": "02_triage@3"
        },
        {
          "command": "leviathan.openSelected.strings",
          "group": "02_triage@4"
        },
        {
          "command": "leviathan.openSelected.iocs",
          "group": "02_triage@5"
        },
        {
          "command": "leviathan.openSelected.search",
          "group": "03_find@1"
        },
        {
          "command": "leviathan.openSelected.multi-search",
          "group": "03_find@2"
        },
        {
          "command": "leviathan.openSelected.parse",
          "group": "04_structure@1"
        },
        {
          "command": "leviathan.openSelected.disasm",
          "group": "04_structure@2"
        },
        {
          "command": "leviathan.openSelected.pdf",
          "group": "04_structure@3"
        },
        {
          "command": "leviathan.openSelected.squashfs",
          "group": "04_structure@4"
        },
        {
          "command": "leviathan.openSelected.spectrogram-encode",
          "group": "05_audio@1"
        },
        {
          "command": "leviathan.openSelected.spectrogram-view",
          "group": "05_audio@2"
        },
        {
          "command": "leviathan.openSelected.diff",
          "group": "06_compare"
        },
        {
          "command": "leviathan.openSelected.carve",
          "group": "07_recover@1"
        },
        {
          "command": "leviathan.openSelected.keys",
          "group": "07_recover@2"
        },
        {
          "command": "leviathan.openSelected.timestamps",
          "group": "07_recover@3"
        },
        {
          "command": "leviathan.openSelected.stego",
          "group": "07_recover@4"
        },
        {
          "command": "leviathan.openSelected.metadata",
          "group": "07_recover@5"
        },
        {
          "command": "leviathan.openSelected.binsnoop",
          "group": "08_advanced@1"
        },
        {
          "command": "leviathan.openSelected.rules",
          "group": "08_advanced@2"
        },
        {
          "command": "leviathan.openSelected.patch-plan",
          "group": "09_edit@1"
        },
        {
          "command": "leviathan.openSelected.patch-apply",
          "group": "09_edit@2"
        },
        {
          "command": "leviathan.openSelected.transform",
          "group": "09_edit@3"
        },
        {
          "command": "leviathan.openSelected.case",
          "group": "10_case"
        }
      ]
    }
  }
}
