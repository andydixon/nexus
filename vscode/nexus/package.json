{
  "name": "nexus",
  "displayName": "Nexus",
  "description": "Nexus terminal connections inside Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "andydixon",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "files": [
    "extension.js",
    "package.json",
    "media/**",
    "bin/**"
  ],
  "activationEvents": [
    "onView:nexus.connections",
    "onCommand:nexus.newProfile",
    "onCommand:nexus.openSettings"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "nexus.refreshConnections",
        "title": "Refresh Connections"
      },
      {
        "command": "nexus.connectLocal",
        "title": "Connect Local Terminal"
      },
      {
        "command": "nexus.openConnection",
        "title": "Open Nexus Connection"
      },
      {
        "command": "nexus.newProfile",
        "title": "New Nexus Profile"
      },
      {
        "command": "nexus.editProfile",
        "title": "Edit Nexus Profile"
      },
      {
        "command": "nexus.duplicateProfile",
        "title": "Duplicate Nexus Profile"
      },
      {
        "command": "nexus.deleteProfile",
        "title": "Delete Nexus Profile"
      },
      {
        "command": "nexus.openSettings",
        "title": "Nexus Settings"
      },
      {
        "command": "nexus.openSftp",
        "title": "Open SFTP Browser"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "nexus",
          "title": "Nexus",
          "icon": "media/nexus.svg"
        }
      ]
    },
    "views": {
      "nexus": [
        {
          "id": "nexus.connections",
          "name": "Connections",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "nexus.openConnection",
          "when": "view == nexus.connections && viewItem == profile",
          "group": "inline"
        },
        {
          "command": "nexus.editProfile",
          "when": "view == nexus.connections && viewItem == profile",
          "group": "navigation@1"
        },
        {
          "command": "nexus.duplicateProfile",
          "when": "view == nexus.connections && viewItem == profile",
          "group": "navigation@2"
        },
        {
          "command": "nexus.deleteProfile",
          "when": "view == nexus.connections && viewItem == profile",
          "group": "navigation@3"
        },
        {
          "command": "nexus.openSftp",
          "when": "view == nexus.connections && viewItem == profile",
          "group": "navigation@4"
        }
      ]
    }
  }
}
