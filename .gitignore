# ==========================================================================
# Nexus Terminal — .gitignore
# ==========================================================================

# ── Build output ──────────────────────────────────────────────────────────
rust/target/
build/releases/

# ── IDE / editor ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS metadata ───────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
Desktop.ini

# ── Application data (never commit user data or secrets) ──────────────────
*.db
*.sqlite
*.sqlite3
vault.json
*.pem
*.key

# Compatibility fixtures generated from the last Go build are deliberate test data.
!rust/core/tests/fixtures/**

# Agent worktrees
.claude/worktrees/

# User guide LaTeX output
docs/guide/build/
